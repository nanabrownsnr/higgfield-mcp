# Higgfield MCP Configuration

# Service Identity
SERVICE_ID=higgfield-mcp
APP_TITLE=Higgfield MCP
APP_VERSION=1.0.0
ENVIRONMENT=development
ROOT_PATH=

# Environment-specific: development, staging, production
ENVIRONMENT_NAME=development

# Security
ALLOWED_ORIGINS=*
PERSONA_ID_HEADER=Persona-Id

# Account Service (JWT verification)
ACCOUNT_SERVICE_URL=http://account_service:8000
ACCOUNT_SERVICE_JWKS_ENDPOINT=/.well-known/jwks.json
ACCOUNT_SERVICE_JWKS_CACHE_TTL=300

# Usage Reporting
USAGE_REPORT_ENDPOINT=http://usage-reporting:8000/api/v1/usage

# MongoDB
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=higgfield

# Encryption
ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_ENCRYPTION_KEY_FOR_FERNET

# License Server (optional for enterprise)
LICENSE_KEY=REPLACE_WITH_ACTIVATION_KEY
LICENSE_SERVER_BASE_URL=https://license-server.example.com
LICENSE_SERVER_JWKS_ENDPOINT=/.well-known/jwks.json
LICENSE_SERVER_ACTIVATION_ENDPOINT=/api/v1/activate

# File Storage (optional)
FILE_STORAGE_URL=https://file-storage.example.com
QUEST_CLIENT_ID=
QUEST_CLIENT_SECRET=

# OpenAI (if using GPT integration)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4